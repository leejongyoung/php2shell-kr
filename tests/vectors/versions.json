{
  "_comment": "Shared contract for every implementation (Python, POSIX sh, PowerShell). Version string -> classification when only the upstream version number is known. 'fixed' means >= the first fixed release of its branch; vendor backports are decided separately.",
  "classes": {
    "fixed": "upstream version contains the fix",
    "vulnerable": "supported branch (8.2-8.5, 8.6 pre-RC4) below the fixed release",
    "eol_backport": "7.4 / 8.0 / 8.1: affected, no official release, only vendor packages or source backport",
    "eol_no_fix": "5.4-7.3: affected, EOL, no fix anywhere",
    "old_unsupported": "below 5.4: not in the published affected range but long EOL; not safe, migrate",
    "unknown": "cannot parse"
  },
