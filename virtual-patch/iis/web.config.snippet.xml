<?xml version="1.0" encoding="utf-8"?>
<!--
  PHP2Shell (CVE-2026-109618 / CVE-2026-109619) 임시 완화: IIS web.config 조각
  상태    : 미검증: IIS 환경 없음 (구문/동작 시험 안 함. 스테이징에서 확인 필수)
  목적    : 요청 본문 크기 상한, 업로드 없는 사이트의 multipart 차단(선택).
  한계    : 완전한 완화책이 아니다(PHP 공식 입장). 일부 경로만 줄이며 우회될 수 있다.
            웹셸 설치 후 피해는 막지 못한다. 근본 조치는 패치다.
  적용 전 : web.config 를 백업하고 <system.webServer> 안에 병합. 메모리 상한은 앱 풀의
            Private Memory 제한 등 OS/IIS 수준에서 따로 설정.
  롤백    : 백업한 web.config 로 되돌린다.
  maxAllowedContentLength 단위는 바이트: 8M=8388608, 32M=33554432.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="@@POST_MAX_BYTES@@" />
      </requestFiltering>
    </security>

    <!-- 선택: 업로드가 없는 사이트 전용. 업로드가 있으면 제거. URL Rewrite 모듈 필요. -->
    <rewrite>
      <rules>
        <rule name="PHP2Shell block multipart" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_CONTENT_TYPE}" pattern="^\s*multipart/form-data" ignoreCase="true" />
          </conditions>
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="multipart blocked" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
